{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "stem_db",
      "database_name": "stem",
      "database_id": "4435d041-ac38-4ccc-8f97-cea03f10494e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "cdn"
    },
    {
      "binding": "APP_FILES",
      "bucket_name": "applications"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
