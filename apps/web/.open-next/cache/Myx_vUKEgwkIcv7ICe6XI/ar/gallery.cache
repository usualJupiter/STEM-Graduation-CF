gment\"\n2:I[1145,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"3357\",\"static/chunks/3357-9a70cc7254da7a81.js\",\"2175\",\"static/chunks/2175-37e23c76925b4fd5.js\",\"1329\",\"static/chunks/1329-f9f1ccc5848e60fb.js\",\"2012\",\"static/chunks/app/%5Blocale%5D/(site)/(sections)/(resources)/gallery/page-b9b871906cb4ee4e.js\"],\"default\"]\n4:I[4435,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"8450\",\"static/chunks/app/%5Blocale%5D/layout-f1a353229b3c62f8.js\"],\"DirectionProvider\"]\n5:I[9630,[],\"\"]\n6:I[1380,[],\"\"]\n7:I[9035,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"5587\",\"static/chunks/5587-bf113d0b27940924.js\",\"2119\",\"static/chunks/2119-e1146b92559c9f35.js\",\"7114\",\"static/chunks/7114-9c2b8aa1bf81ea53.js\",\"2034\",\"static/chunks/2034-a917108ee17ecc1e.js\",\"3224\",\"static/chunks/app/%5Blocale%5D/not-found-b950e99fc0dfde3b.js\"],\"default\"]\n:HL[\"/_next/static/css/cfb57f7f318bc189.css\",\"style\"]\n:HL[\"/_next/static/css/5d4b6e5564e54306.css\",\"style\"]\n0:{\"buildId\":\"Myx_vUKEgwkIcv7ICe6XI\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/cfb57f7f318bc189.css\",\"precedence\":\"next\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/5d4b6e5564e54306.css\",\"precedence\":\"next\"}]],[\"$\",\"html\",null,{\"lang\":\"ar\",\"dir\":\"rtl\",\"suppressHydrationWarning\":true,\"className\":\"antialiased __variable_ad1c25 __className_ad1c25\",\"children\":[\"$\",\"body\",null,{\"className\":\"bg-main\",\"children\":[\"$\",\"$L2\",null,{\"locale\":\"ar\",\"messages\":{\"Metadata\":{\"home\":{\"title\":\"برنامج ستيم | الرئيسية\",\"description\":\"برنامج ستيم بجامعة أسيوط\"},\"programs\":{\"title\":\"برنامج ستيم | البرامج\",\"description\":\"تصفّح برامج البكالوريوس في برنامج ستيم بجامعة أسيوط.\"},\"events\":{\"title\":\"برنامج ستيم | الأنشطة\",\"description\":\"أحدث الفعاليات والأنشطة في برنامج ستيم.\"},\"gallery\":{\"title\":\"برنامج ستيم | معرض الصور\",\"description\":\"نظرة بصرية على الحياة الطلابية والأنشطة في برنامج ستيم.\"},\"schedules\":{\"title\":\"برنامج ستيم | جداول المحاضرات\",\"description\":\"أحدث جداول المحاضرات لمقررات برنامج ستيم.\"},\"capstones\":{\"title\":\"برنامج ستيم | مشاريع الكابستون\",\"description\":\"مشاريع كابستون الطلاب عبر تخصصات برنامج ستيم.\"},\"about\":{\"title\":\"برنامج ستيم | من نحن\",\"description\":\"تعرّف على برنامج ستيم بكلية التربية، جامعة أسيوط.\"}},\"Nav\":{\"logoAlt\":\"ستيم سي إف\",\"openMenu\":\"افتح القائمة\",\"menu\":\"التنقل\",\"language\":\"اللغة\",\"apply\":\"قدّم الآن\",\"programs\":\"البرامج\",\"events\":\"الانشطة\",\"resources\":\"مصادر\",\"gallery\":\"معرض الصور\",\"schedules\":\"جداول المحاضرات\",\"capstones\":\"مشاريع الكابستون\",\"about\":\"من نحن\",\"english\":\"English\",\"arabic\":\"العربية\"},\"Hero\":{\"heading\":\"المجتمع الرائد\\nلمعلمي مدارس ستيم\",\"description\":\"نُعِدّ الجيل القادم من معلمي مصر بتدريب متكامل في العلوم والتكنولوجيا والهندسة والرياضيات، يقوم على البحث والاستقصاء ومعالجة تحديات الواقع.\",\"cta\":\"اعرف المزيد\",\"imageAlt\":\"صورة القسم الرئيسي\"},\"CtaOne\":{\"heading\":\"رسالتنا وقيمنا الأساسية\",\"description\":\"تسعى فلسفة مدارس ستيم إلى تجاوز المواد الأكاديمية البحتة لدمج العلوم والتكنولوجيا والهندسة والرياضيات (STEM) وتوظيفها في مواجهة أبرز التحديات المجتمعية.\\nلذلك تسعى برامج بكالوريوس العلوم والتربية في ستيم إلى إعداد معلمين مفكرين ومحترفين وممارسين وباحثين قادرين على التعلم الذاتي.\",\"apply\":\"قدّم الآن\",\"browsePrograms\":\"تصفح البرامج\",\"quickLinks\":\"روابط سريعة\",\"programs\":{\"physics\":\"بكالوريوس العلوم والتربية (الفيزياء)\",\"chemistry\":\"بكالوريوس العلوم والتربية (الكيمياء)\",\"biology\":\"بكالوريوس العلوم والتربية (الأحياء)\",\"geology\":\"بكالوريوس العلوم والتربية (الجيولوجيا)\",\"mathematics\":\"بكالوريوس العلوم والتربية (الرياضيات)\"}},\"Life\":{\"tagline\":\"الحياة الطلابية\",\"title\":\"الحياة الطلابية في ستيم\",\"description\":\"عِشْ أكثر من مجرد تعليم، واستكشف الحياة الطلابية النابضة والأندية الثقافية المتنوعة في ستيم.\",\"cta\":\"اعرف المزيد\",\"imageAlt\":\"الحياة الطلابية في ستيم\"},\"CapstoneShow\":{\"tagline\":\"معرض مشاريع الكابستون\",\"heading\":\"عرض مشاريع الكابستون لطلابنا\",\"description\":\"تصفّح معرضاً مختاراً لمشاريع كابستون الطلاب عبر تخصصات ستيم المختلفة.\",\"slideAlt\":\"مشروع كابستون {n}\",\"goToSlide\":\"انتقل إلى الشريحة {n}\"},\"Events\":{\"tagline\":\"شاهد كل الأنشطة\",\"heading\":\"أحدث الأنشطة\",\"description\":\"تعرّف على برنامج ستيم في أحدث فعالياتنا.\"},\"Aword\":{\"quote\":\"تمنح ستيم طلابنا الأدوات والمجتمع والرؤية لمواجهة أكبر تحديات المستقبل، ونحن فخورون بكل معلم يُسهم في تحقيق ذلك.\",\"name\":\"د. ماريان ميلاد\",\"role\":\"منسقة البرنامج\"},\"ProgramsHeader\":{\"title\":\"البرامج\",\"imageAlt\":\"صورة قسم البرامج\"},\"Programs\":{\"subjects\":{\"physics\":\"الفيزياء\",\"chemistry\":\"الكيمياء\",\"biology\":\"الأحياء\",\"geology\":\"الجيولوجيا\",\"mathematics\":\"الرياضيات\"},\"overview\":{\"heading\":\"نظرة عامة\",\"subheading\":\"باختصار...\"},\"labels\":{\"course\":\"البرنامج\",\"duration\":\"المدة\",\"credit\":\"الساعات المعتمدة\",\"degree\":\"الدرجة العلمية\"},\"details\":{\"physics\":{\"course\":\"العلوم والتربية (شعبة الفيزياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الفيزياء)\",\"description\":\"يجمع البرنامج بين الفيزياء المتقدمة وأساليب التدريس الحديثة، ويُعدّ خريجين قادرين على تدريس الميكانيكا والكهرومغناطيسية والديناميكا الحرارية ومفاهيم فيزياء الكم في فصول ستيم. تتكامل الدراسة النظرية مع التطبيق المعملي ومناهج البحث والتدريب الميداني لإعداد معلمين واثقين ومحفّزين للتفكير الاستقصائي.\"},\"chemistry\":{\"course\":\"العلوم والتربية (شعبة الكيمياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الكيمياء)\",\"description\":\"يدرس الطلاب الكيمياء العضوية وغير العضوية والفيزيائية والتحليلية إلى جانب مقررات تربوية تربط بين النظرية والممارسة داخل الفصل. يركّز المنهج على السلامة المعملية وتصميم التجارب ودور الكيمياء في حل قضايا الصناعة والصحة والبيئة.\"},\"biology\":{\"course\":\"العلوم والتربية (شعبة الأحياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الأحياء)\",\"description\":\"يتناول البرنامج علم الخلية والوراثة والبيئة والتطور وبيولوجيا الإنسان عبر المحاضرات والعمل المعملي والدراسات الميدانية. كما تُعدّ مقررات طرق التدريس الخريجين لقيادة فصول علوم قائمة على الاستقصاء وربط المفاهيم البيولوجية بالاستدامة والصحة والحياة اليومية.\"},\"geology\":{\"course\":\"العلوم والتربية (شعبة الجيولوجيا باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الجيولوجيا)\",\"description\":\"يغطّي البرنامج أنظمة الأرض وعلم المعادن والصفائح التكتونية وعلم الأحافير والجيولوجيا البيئية إلى جانب أصول التدريس. يتخرج الطلاب قادرين على تدريس علوم الأرض والفضاء مع التركيز على الملاحظة الميدانية وتفسير البيانات ودور علوم الأرض في قضايا المناخ والموارد.\"},\"mathematics\":{\"course\":\"العلوم والتربية (شعبة الرياضيات باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الرياضيات)\",\"description\":\"يدرس الطلاب التفاضل والتكامل والجبر الخطي والإحصاء والرياضيات المتقطعة والمنطق الرياضي، إلى جانب أحدث أساليب تدريس الرياضيات للمرحلة الثانوية. ويُبنى البرنامج ليعمّق المعرفة الرياضية ويُنمّي قدرة الخريج على تصميم دروس واضحة وجذابة لمتعلمين متنوعين.\"}},\"imageAlt\":\"صورة البرنامج\"},\"Fees\":{\"tuition\":{\"title\":\"الرسوم الدراسية\",\"description\":\"٢٠٠ جنيه للساعة المعتمدة في الفصل الدراسي + الرسوم الإدارية (كارنيه الطالب).\"},\"graduation\":{\"title\":\"متطلبات التخرج\",\"description\":\"إتمام ١٥٠ ساعة معتمدة.\\nالحصول على معدل تراكمي لا يقل عن ٢٫٠.\\nاجتياز مقرر اللغة العربية.\"}},\"GalleryHeader\":{\"title\":\"معرض الصور\",\"imageAlt\":\"صورة قسم المعرض\"},\"EventsHeader\":{\"title\":\"الأنشطة\",\"imageAlt\":\"صورة قسم الأنشطة\"},\"EventsList\":{\"empty\":\"لا توجد أنشطة بعد.\"},\"EventDetail\":{\"date\":\"التاريخ\",\"time\":\"الوقت\"},\"AboutHeader\":{\"title\":\"من نحن\",\"imageAlt\":\"صورة قسم المن نحن\"},\"About\":{\"letter\":\"مرحبًا بكم في برنامج ستيم بكلية التربية، جامعة أسيوط. نُعِدّ معلمي المستقبل لقيادة فصول دراسية قائمة على البحث والاستقصاء، نُكامل فيها بين العلوم والتكنولوجيا والهندسة والرياضيات من خلال التعلم العملي والبحث ومشاريع التخرج التي تربط الدراسة الأكاديمية بأثرٍ ملموس في الواقع.\",\"mapTitle\":\"موقع جامعة أسيوط على خرائط جوجل\"},\"CapstonesHeader\":{\"title\":\"مشاريع الكابستون\",\"imageAlt\":\"صورة قسم المشاريع الكابستون\"},\"Capstones\":{\"levels\":{\"level1\":\"المستوى الأول\",\"level2\":\"المستوى الثاني\",\"level3\":\"المستوى الثالث\"},\"empty\":\"لا توجد مشاريع بعد\"},\"Capstone\":{\"notFound\":\"المشروع غير موجود\",\"header\":{\"tagline\":\"المستوى {level} · الفصل {semester} · {year}\",\"supervisor\":\"المشرف\",\"students\":\"الطلاب\",\"semester\":{\"first\":\"الأول\",\"second\":\"الثاني\"}},\"sections\":{\"abstract\":\"المُلخّص\",\"introduction\":\"المقدمة\",\"methodology\":\"المنهجية\",\"analysis\":\"التحليل والنتائج\",\"conclusion\":\"الخاتمة\",\"recommendations\":\"التوصيات\",\"materials\":\"الخامات\",\"producers\":\"المنفّذون\",\"pictures\":\"صور المشروع\"},\"resources\":{\"title\":\"الموارد\",\"tagline\":\"روابط\",\"presentation\":\"عرض المشروع\",\"portfolio\":\"بورتفوليو المشروع\",\"poster\":\"ملصق المشروع\",\"browse\":\"تصفّح المشاريع\",\"imageAlt\":\"صورة قسم الموارد\"}},\"SchedulesHeader\":{\"title\":\"جداول المحاضرات\",\"imageAlt\":\"صورة قسم جداول المحاضرات\"},\"Schedules\":{\"levels\":{\"level1\":\"المستوى الأول\",\"level2\":\"المستوى الثاني\",\"level3\":\"المستوى الثالث\",\"level4\":\"المستوى الرابع\"},\"pdfTitle\":\"ملف جدول المحاضرات\"},\"NotFound\":{\"tagline\":\"الصفحة غير موجودة\",\"heading\":\"404\",\"description\":\"عذرًا، لم نتمكن من العثور على الصفحة التي تبحث عنها.\",\"buttonLabel\":\"الصفحة الرئيسية\"},\"Footer\":{\"logoAlt\":\"برنامج ستيم\",\"orgName\":\"برنامج ستيم - كلية التربية\",\"contact\":\"جامعة أسيوط - كلية التربية\\nالبريد الإلكتروني: edu@aun.edu.eg\\nالهاتف: (088) 2080243\",\"followUs\":\"تابعنا\",\"resources\":\"المصادر\",\"sitemap\":\"خريطة الموقع\",\"copyright\":\"© 2026 برنامج ستيم - قسم علوم الحاسب\",\"privacy\":\"سياسة الخصوصية\",\"social\":{\"facebook\":\"فيسبوك\",\"whatsapp\":\"واتساب\"},\"resourceLinks\":{\"schedules\":\"جداول المحاضرات\",\"gallery\":\"معرض الصور\",\"apply\":\"قدّم الآن\"},\"mapLinks\":{\"home\":\"الرئيسية\",\"programs\":\"البرامج\",\"events\":\"الأنشطة\",\"capstones\":\"مشاريع الكابستون\",\"about\":\"من نحن\"}}},\"timeZone\":\"Africa/Cairo\",\"children\":\"$L3\"}]}]}]]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"$L4\",null,{\"dir\":\"rtl\",\"children\":[\"$\",\"$L5\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L6\",null,{}],\"notFound\":[[\"$\",\"section\",null,{\"className\":\"relative w-full overflow-hidden bg-secondry-web\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute inset-0 select-none bg-[url('https://cdn.stem-program.com/assets/capstone-header-bg.svg')] bg-[length:100%_100%] bg-no-repeat\"}],[\"$\",\"div\",null,{\"className\":\"relative z-10 flex min-h-screen w-full flex-col items-center justify-center gap-8 px-4 py-16 sm:px-8 md:px-16\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-base font-medium text-primary-foreground/80 sm:text-lg\",\"children\":\"الصفحة غير موجودة\"}],[\"$\",\"h1\",null,{\"className\":\"text-center text-8xl font-semibold tracking-tight text-primary-foreground [text-shadow:8px_6px_0_rgba(0,0,0,0.5)] sm:text-9xl md:text-[200px] md:leading-[1] lg:text-[240px]\",\"children\":\"404\"}],[\"$\",\"p\",null,{\"className\":\"max-w-2xl text-center text-xl text-primary-foreground/80 sm:text-2xl\",\"children\":\"عذرًا، لم نتمكن من العثور على الصفحة التي تبحث عنها.\"}],[\"$\",\"$L7\",null,{\"ref\":null,\"href\":\"/ar\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"}