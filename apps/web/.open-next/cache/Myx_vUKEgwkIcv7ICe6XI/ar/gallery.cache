lish\":\"English\",\"arabic\":\"العربية\"},\"Hero\":{\"heading\":\"المجتمع الرائد\\nلمعلمي مدارس ستيم\",\"description\":\"نُعِدّ الجيل القادم من معلمي مصر بتدريب متكامل في العلوم والتكنولوجيا والهندسة والرياضيات، يقوم على البحث والاستقصاء ومعالجة تحديات الواقع.\",\"cta\":\"اعرف المزيد\",\"imageAlt\":\"صورة القسم الرئيسي\"},\"CtaOne\":{\"heading\":\"رسالتنا وقيمنا الأساسية\",\"description\":\"تسعى فلسفة مدارس ستيم إلى تجاوز المواد الأكاديمية البحتة لدمج العلوم والتكنولوجيا والهندسة والرياضيات (STEM) وتوظيفها في مواجهة أبرز التحديات المجتمعية.\\nلذلك تسعى برامج بكالوريوس العلوم والتربية في ستيم إلى إعداد معلمين مفكرين ومحترفين وممارسين وباحثين قادرين على التعلم الذاتي.\",\"apply\":\"قدّم الآن\",\"browsePrograms\":\"تصفح البرامج\",\"quickLinks\":\"روابط سريعة\",\"programs\":{\"physics\":\"بكالوريوس العلوم والتربية (الفيزياء)\",\"chemistry\":\"بكالوريوس العلوم والتربية (الكيمياء)\",\"biology\":\"بكالوريوس العلوم والتربية (الأحياء)\",\"geology\":\"بكالوريوس العلوم والتربية (الجيولوجيا)\",\"mathematics\":\"بكالوريوس العلوم والتربية (الرياضيات)\"}},\"Life\":{\"tagline\":\"الحياة الطلابية\",\"title\":\"الحياة الطلابية في ستيم\",\"description\":\"عِشْ أكثر من مجرد تعليم، واستكشف الحياة الطلابية النابضة والأندية الثقافية المتنوعة في ستيم.\",\"cta\":\"اعرف المزيد\",\"imageAlt\":\"الحياة الطلابية في ستيم\"},\"CapstoneShow\":{\"tagline\":\"معرض مشاريع الكابستون\",\"heading\":\"عرض مشاريع الكابستون لطلابنا\",\"description\":\"تصفّح معرضاً مختاراً لمشاريع كابستون الطلاب عبر تخصصات ستيم المختلفة.\",\"slideAlt\":\"مشروع كابستون {n}\",\"goToSlide\":\"انتقل إلى الشريحة {n}\"},\"Events\":{\"tagline\":\"شاهد كل الأنشطة\",\"heading\":\"أحدث الأنشطة\",\"description\":\"تعرّف على برنامج ستيم في أحدث فعالياتنا.\"},\"Aword\":{\"quote\":\"تمنح ستيم طلابنا الأدوات والمجتمع والرؤية لمواجهة أكبر تحديات المستقبل، ونحن فخورون بكل معلم يُسهم في تحقيق ذلك.\",\"name\":\"د. ماريان ميلاد\",\"role\":\"منسقة البرنامج\"},\"ProgramsHeader\":{\"title\":\"البرامج\",\"imageAlt\":\"صورة قسم البرامج\"},\"Programs\":{\"subjects\":{\"physics\":\"الفيزياء\",\"chemistry\":\"الكيمياء\",\"biology\":\"الأحياء\",\"geology\":\"الجيولوجيا\",\"mathematics\":\"الرياضيات\"},\"overview\":{\"heading\":\"نظرة عامة\",\"subheading\":\"باختصار...\"},\"labels\":{\"course\":\"البرنامج\",\"duration\":\"المدة\",\"credit\":\"الساعات المعتمدة\",\"degree\":\"الدرجة العلمية\"},\"details\":{\"physics\":{\"course\":\"العلوم والتربية (شعبة الفيزياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الفيزياء)\",\"description\":\"يجمع البرنامج بين الفيزياء المتقدمة وأساليب التدريس الحديثة، ويُعدّ خريجين قادرين على تدريس الميكانيكا والكهرومغناطيسية والديناميكا الحرارية ومفاهيم فيزياء الكم في فصول ستيم. تتكامل الدراسة النظرية مع التطبيق المعملي ومناهج البحث والتدريب الميداني لإعداد معلمين واثقين ومحفّزين للتفكير الاستقصائي.\"},\"chemistry\":{\"course\":\"العلوم والتربية (شعبة الكيمياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الكيمياء)\",\"description\":\"يدرس الطلاب الكيمياء العضوية وغير العضوية والفيزيائية والتحليلية إلى جانب مقررات تربوية تربط بين النظرية والممارسة داخل الفصل. يركّز المنهج على السلامة المعملية وتصميم التجارب ودور الكيمياء في حل قضايا الصناعة والصحة والبيئة.\"},\"biology\":{\"course\":\"العلوم والتربية (شعبة الأحياء باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الأحياء)\",\"description\":\"يتناول البرنامج علم الخلية والوراثة والبيئة والتطور وبيولوجيا الإنسان عبر المحاضرات والعمل المعملي والدراسات الميدانية. كما تُعدّ مقررات طرق التدريس الخريجين لقيادة فصول علوم قائمة على الاستقصاء وربط المفاهيم البيولوجية بالاستدامة والصحة والحياة اليومية.\"},\"geology\":{\"course\":\"العلوم والتربية (شعبة الجيولوجيا باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الجيولوجيا)\",\"description\":\"يغطّي البرنامج أنظمة الأرض وعلم المعادن والصفائح التكتونية وعلم الأحافير والجيولوجيا البيئية إلى جانب أصول التدريس. يتخرج الطلاب قادرين على تدريس علوم الأرض والفضاء مع التركيز على الملاحظة الميدانية وتفسير البيانات ودور علوم الأرض في قضايا المناخ والموارد.\"},\"mathematics\":{\"course\":\"العلوم والتربية (شعبة الرياضيات باللغة الإنجليزية)\",\"duration\":\"أربع سنوات\",\"credit\":\"١٢٠ ساعة\",\"degree\":\"بكالوريوس العلوم والتربية (الرياضيات)\",\"description\":\"يدرس الطلاب التفاضل والتكامل والجبر الخطي والإحصاء والرياضيات المتقطعة والمنطق الرياضي، إلى جانب أحدث أساليب تدريس الرياضيات للمرحلة الثانوية. ويُبنى البرنامج ليعمّق المعرفة الرياضية ويُنمّي قدرة الخريج على تصميم دروس واضحة وجذابة لمتعلمين متنوعين.\"}},\"imageAlt\":\"صورة البرنامج\"},\"Fees\":{\"tuition\":{\"title\":\"الرسوم الدراسية\",\"description\":\"٢٠٠ جنيه للساعة المعتمدة في الفصل الدراسي + الرسوم الإدارية (كارنيه الطالب).\"},\"graduation\":{\"title\":\"متطلبات التخرج\",\"description\":\"إتمام ١٥٠ ساعة معتمدة.\\nالحصول على معدل تراكمي لا يقل عن ٢٫٠.\\nاجتياز مقرر اللغة العربية.\"}},\"GalleryHeader\":{\"title\":\"معرض الصور\",\"imageAlt\":\"صورة قسم المعرض\"},\"EventsHeader\":{\"title\":\"الأنشطة\",\"imageAlt\":\"صورة قسم الأنشطة\"},\"EventsList\":{\"empty\":\"لا توجد أنشطة بعد.\"},\"EventDetail\":{\"date\":\"التاريخ\",\"time\":\"الوقت\"},\"AboutHeader\":{\"title\":\"من نحن\",\"imageAlt\":\"صورة قسم المن نحن\"},\"About\":{\"letter\":\"مرحبًا بكم في برنامج ستيم بكلية التربية، جامعة أسيوط. نُعِدّ معلمي المستقبل لقيادة فصول دراسية قائمة على البحث والاستقصاء، نُكامل فيها بين العلوم والتكنولوجيا والهندسة والرياضيات من خلال التعلم العملي والبحث ومشاريع التخرج التي تربط الدراسة الأكاديمية بأثرٍ ملموس في الواقع.\",\"mapTitle\":\"موقع جامعة أسيوط على خرائط جوجل\"},\"CapstonesHeader\":{\"title\":\"مشاريع الكابستون\",\"imageAlt\":\"صورة قسم المشاريع الكابستون\"},\"Capstones\":{\"levels\":{\"level1\":\"المستوى الأول\",\"level2\":\"المستوى الثاني\",\"level3\":\"المستوى الثالث\"},\"empty\":\"لا توجد مشاريع بعد\"},\"Capstone\":{\"notFound\":\"المشروع غير موجود\",\"h