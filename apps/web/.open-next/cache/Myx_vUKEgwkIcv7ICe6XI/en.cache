ks/5587-bf113d0b27940924.js\",\"5947\",\"static/chunks/5947-c6c75866b94239bd.js\",\"4040\",\"static/chunks/app/%5Blocale%5D/(site)/page-be597c2be9aaf881.js\"],\"default\"]\n1b:I[6357,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"3357\",\"static/chunks/3357-9a70cc7254da7a81.js\",\"2175\",\"static/chunks/2175-37e23c76925b4fd5.js\",\"1329\",\"static/chunks/1329-f9f1ccc5848e60fb.js\",\"5587\",\"static/chunks/5587-bf113d0b27940924.js\",\"5947\",\"static/chunks/5947-c6c75866b94239bd.js\",\"4040\",\"static/chunks/app/%5Blocale%5D/(site)/page-be597c2be9aaf881.js\"],\"default\"]\n1c:I[9890,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"3357\",\"static/chunks/3357-9a70cc7254da7a81.js\",\"2175\",\"static/chunks/2175-37e23c76925b4fd5.js\",\"1329\",\"static/chunks/1329-f9f1ccc5848e60fb.js\",\"5587\",\"static/chunks/5587-bf113d0b27940924.js\",\"5947\",\"static/chunks/5947-c6c75866b94239bd.js\",\"4040\",\"static/chunks/app/%5Blocale%5D/(site)/page-be597c2be9aaf881.js\"],\"default\"]\n1d:T6c8,Assiut University Launches First Annual Capstone Projects Exhibition – STEM Program at the Faculty of Education\n\nIn a high-level ceremony attended by Professor Dr. Ahmed El-Menshawy, President of Assiut University, a number of university leaders, and Major General Dr. Hesham Abu El-Nasr, Governor of Assiut, the university witnessed the launch of its first annual Capstone Projects Exhibition for undergraduate students in the STEM program at the Faculty of Education.\n\nTwenty-eight innovative projects, presented by 138 students, showcased practical ideas in the fields of renewable energy, smart agriculture, digital transformation, health, and the environment. These were not merely theoretical ideas, but rather realistic and applicable solutions that embody the spirit of innovation among STEM students.\n\nThe exhibition aligns with Egypt's Vision 2030 and aims to empower young minds, develop skills, and support scientific innovation to achieve sustainable development.\n\nFive projects received awards for excellence, most notably:\n\nThe \"Wave Energy\" project for generating energy from water movement,\n\nThe \"Kidney+App\" application to support kidney patients,\n\nThe \"Vertical Agriculture\" project,\n\n\"Parkn Bridge\" to address traffic congestion.\n\nThe Faculty of Education – under the leadership of its Dean, Professor Dr. Hassan Hawil, and with the support of the Vice Dean, Dr. Mohamed Gaber Qassem, and under the supervision of the Program Coordinator and Head of Department, Professor Dr. Marian Milad Mansour – has proven its role as a center of innovation and a gateway to graduating a generation capable of shaping the future.\n\nAssiut University today does not just award degrees; it cultivates minds that create change.1e:T85c,جامعة أسيوط تُطلق المعرض السنوي الأول لمشروعات Capstone – برنامج STEM بكلية التربية\n\nفي حضور رفيع المستوى، تقدّمه الأستاذ الدكتور أحمد المنشاوي – رئيس جامعة أسيوط، ونخبة من قيادات الجامعة، وبمشاركة سيادة اللواء الدكتور هشام أبو النصر – محافظ أسيوط، شهدت الجامعة انطلاق المعرض السنوي الأول لمشروعات الكابستون لطلاب البكالوريوس في العلوم  STEM – بكلية التربية.\n\n28 مشروعًا مبتكرًا، و138 طالبًا وطالبة، عرضوا أفكارًا عملية في مجالات الطاقة المتجددة، الزراعة الذكية، التحول الرقمي، الصحة، والبيئة. لم تكن مجرد أفكار نظرية، بل حلول واقعية قابلة للتطبيق، تُجسد روح الابتكار لدى طلاب STEM.\n\nجاء المعرض ضمن رؤية مصر 2030، وهدفه تمكين العقول الشابة، وتنمية المهارات، ودعم الابتكار العلمي لتحقيق التنمية المستدامة.\n\nخمسة مشاريع نالت جوائز التميز، أبرزها:\n\nمشروع \"Wave Energy\" لتوليد الطاقة من حركة المياه،\n\nتطبيق \"Kidney+App\" لدعم مرضى الكلى،\n\nمشروع \"Vertical Agriculture\"،\n\n\"Parkn Bridge\" لحل أزمة المرور.\n\nكلية التربية – بقيادة عميدها الأستاذ الدكتور حسن حويل، وبدعم من وكيل الكلية الدكتور محمد جابر قاسم، وتحت إشراف منسقة البرنامج ورئيسة القسم الأستاذة الدكتورة ماريان ميلاد منصور – أثبتت دورها كمركز للابتكار وبوابة لتخريج جيل قادر على صناعة المستقبل.\n\nجامعة أسيوط اليوم لا تمنح شهادات فقط، بل تُخرج عقولًا تصنع التغيير7:[\"$\",\"main\",null,{\"className\":\"min-h-svh\",\"children\":[[\"$\",\"$L18\",null,{}],[\"$\",\"$L19\",null,{}],[\"$\",\"$L1a\",null,{}],[\"$\",\"$L1b\",null,{}],[\"$\",\"$L1c\",null,{\"items\":[{\"id\":3,\"title_en\":\"First annual exhibition of projects\",\"title_ar\":\"المعرض السنوي الأول لمشروعات\",\"description_en\":\"$1d\",\"description_ar\":\"$1e\",\"event_date\":\"2026-07-09\",\"event_time\":\"08:00\",\"card_photo_url\":\"https://cdn.stem-program.com/events/0dedc260-c996-4d78-ac9e-ef57eaa903a7.webp\",\"created_at\":\"2026-05-03T10:55:01.615Z\"},{\"id\":2,\"title_en\":\"Green Dream Student Conference\",\"title_ar\":\"مؤتمر الحلم الأخضر الطلابي\",\"description_en\":\"STEM students excelled and won two outstanding projects\\n\\nAt the first Green Dream Student Conference of Assiut University\\n\\nUnder the theme:\\n\\n\\\"Environmental and Social Sustainable Development: Problems and Solutions\\\"\\n\\nThe first project... Designing an innovative solar cell to produce clean energy\\n\\nThe second project... Generating electricity from wind turbines using unconventional technologies\",\"description_ar\":\"تألّق طلاب STEM وفازوا بمشروعين متميزين\\nضمن فعاليات مؤتمر الحلم الأخضر الطلابي الأول لجامعة أسيوط\\nتحت عنوان:\\n\\\"التنمية المستدامة البيئية والمجتمعية: المشكلات والحلول\\\"\\nالمشروع الأول... تصميم خلية شمسية مبتكرة لإنتاج الطاقة النظيفة\\nوالمشروع الثاني... توليد الكهرباء من حركة الرياح باستخدام تقنيات غير تقليدية\",\"event_date\":\"2025-09-12\",\"event_time\":\"08:00\",\"card_photo_url\":\"https://cdn.stem-program.com/events/de547635-afdb-42aa-b83d-9c785e5f9c16.webp\",\"created_at\":\"2026-05-03T10:52:56.156Z\"},{\"id\":1,\"title_en\":\"Trip to Switzerland\",\"title_ar\":\"رحلة الي سويسرا\",\"description_en\":\"Three STEM Level 3 Mathematics students travel to the University of Zurich in Switzerland for teacher training.\",\"description_ar\":\"سفر 3 من طلاب ستيم المستوى الثالث رياضيات إلى جامعة زيوريخ بسويسرا لإعداد المعلمين\",\"event_date\":\"2024-03-03\",\"event_time\":\"08:00\",\"card_photo_url\":\"https://cdn.stem-program.com/events/68c79485-bf06-4544-ac31-aa4d1a365e0b.webp\",\"created_at\":\"2026-05-03T10:50:20.237Z\"}]}],\"$L1f\"]}]\n20:I[4001,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"3357\",\"static/chunks/3357-9a70cc7254da7a81.js\",\"2175\",\"static/chunks/2175-37e23c76925b4fd5.js\",\"1329\",\"static/chunks/1329-f9f1ccc5848e60fb.js\",\"5587\",\"static/chunks/5587-bf113d0b27940924.js\",\"5947\",\"static/chunks/5947-c6c75866b94239bd.js\",\"4040\",\"static/chunks/app/%5Blocale%5D/(site)/page-be597c2be9aaf881.js\"],\"default\"]\n1f:[\"$\",\"$L20\",null,{}]\n","segmentData":{"/_tree":":HL[\"/_next/static/css/cfb57f7f318bc189.css\",\"style\"]\n:HL[\"/_next/static/css/5d4b6e5564e54306.css\",\"style\"]\n0:{\"buildId\":\"Myx_vUKEgwkIcv7ICe6XI\",\"tree\":{\"name\":\"\",\"paramType\":null,\"paramKey\":\"\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"locale\",\"paramType\":\"d\",\"paramKey\":\"en\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"(site)\",\"paramType\":null,\"paramKey\":\"(site)\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"paramType\":null,\"paramKey\":\"__PAGE__\",\"hasRuntimePrefetch\":false,\"slots\":null,\"isRootLayout\":false}},\"isRootLayout\":false}},\"isRootLayout\":true}},\"isRootLayout\":false},\"staleTime\":300}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[9630,[],\"\"]\n3:I[1380,[],\"\"]\n5:I[2332,[\"6305\",\"static/chunks/6305-d1fa0be563041f0a.js\",\"3357\",\"static/chunks/3357-9a70cc7254da7a81.js\",\"2175\",\"static/chunks/2175-37e23c76925b4fd5.js\",\"5587\",\"static/chunks/5587-bf113d0b27940924.js\",\"2119\",\"static/chunks/2119-e1146b92559c9f35.js\",\"7114\",\"static/chunks/7114-9c2b8aa1bf81ea53.js\",\"9048\",\"static/chunks/9048-3239fd2233793502.js\",\"3099\",\"static/chunks/app/%5Blocale%5D/(site)/layout-b8867be87a8b1dc4.js\"],\"Nav\"]\n6:I[5725,[\"6305\",\"static/chunks/6305-d1fa0be56